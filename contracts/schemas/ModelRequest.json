{
  "$defs": {
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/$defs/ModelToolCall"
          },
          "title": "Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "ModelToolCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "title": "ModelToolCall",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "recovery": {
          "default": "manual",
          "enum": [
            "pure",
            "idempotency_key",
            "query",
            "manual"
          ],
          "title": "Recovery",
          "type": "string"
        },
        "risks": {
          "items": {
            "enum": [
              "read",
              "write",
              "delete",
              "exec",
              "egress"
            ],
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "timeout_ms": {
          "exclusiveMinimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "input_schema",
        "timeout_ms"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "max_output_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ChatMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "require_refs": {
      "default": false,
      "title": "Require Refs",
      "type": "boolean"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolSpec"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "messages",
    "max_output_tokens"
  ],
  "title": "ModelRequest",
  "type": "object"
}
