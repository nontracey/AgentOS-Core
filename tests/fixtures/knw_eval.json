{
 "kind": "knw_frozen_eval_v1",
 "corpus": [
  {
   "source_id": "t01-zh",
   "lang": "zh",
   "text": "内核采用写前日志方式落盘，进程意外退出后重启可以从检查点继续，已完成的工作不会丢失。"
  },
  {
   "source_id": "t01-en",
   "lang": "en",
   "text": "The kernel uses write-ahead logging so that after an abrupt process exit it can resume from a checkpoint and finished work is never lost."
  },
  {
   "source_id": "t02-zh",
   "lang": "zh",
   "text": "每个动作都有唯一编号记录在步骤账本里，同一个编号重复提交只会生效一次。"
  },
  {
   "source_id": "t02-en",
   "lang": "en",
   "text": "Every action gets a unique id in the step ledger; submitting the same id twice takes effect exactly once."
  },
  {
   "source_id": "t03-zh",
   "lang": "zh",
   "text": "高危操作必须先经过人工批准，批准凭据只能被消费一次，用过即作废。"
  },
  {
   "source_id": "t03-en",
   "lang": "en",
   "text": "Risky operations require prior human approval; an approval grant is single-use and invalidated after consumption."
  },
  {
   "source_id": "t04-zh",
   "lang": "zh",
   "text": "审计记录按顺序串联指纹，任何一条被篡改都会导致链条校验失败。"
  },
  {
   "source_id": "t04-en",
   "lang": "en",
   "text": "Audit records are chained by fingerprints; tampering with any entry breaks chain verification."
  },
  {
   "source_id": "t05-zh",
   "lang": "zh",
   "text": "面对诱导文本的输入，系统只执行白名单内的动作，未登记的指令一律拒绝。"
  },
  {
   "source_id": "t05-en",
   "lang": "en",
   "text": "Against prompt-injection text the system only performs allow-listed actions and rejects unregistered instructions."
  },
  {
   "source_id": "t06-zh",
   "lang": "zh",
   "text": "每个任务都有花销上限，超过额度后新调用会被熔断，避免失控消耗。"
  },
  {
   "source_id": "t06-en",
   "lang": "en",
   "text": "Each task has a spending cap; once exceeded further calls are circuit-broken to prevent runaway cost."
  },
  {
   "source_id": "t07-zh",
   "lang": "zh",
   "text": "工具同时支持本地子进程与远程超文本两种接入方式，注册后统一编排。"
  },
  {
   "source_id": "t07-en",
   "lang": "en",
   "text": "Tools can attach via local subprocess or remote HTTP transport, unified after registration."
  },
  {
   "source_id": "t08-zh",
   "lang": "zh",
   "text": "技能包按需加载：先读简介，需要时才展开正文，减少上下文占用。"
  },
  {
   "source_id": "t08-en",
   "lang": "en",
   "text": "Skill packages load progressively: metadata first, body only when needed, saving context."
  },
  {
   "source_id": "t09-zh",
   "lang": "zh",
   "text": "流程定义带版本发布，启动时锁定某一版，之后改动不影响在跑实例。"
  },
  {
   "source_id": "t09-en",
   "lang": "en",
   "text": "Workflow definitions are versioned on publish; a start pins one version immune to later edits."
  },
  {
   "source_id": "t10-zh",
   "lang": "zh",
   "text": "知识条目带访问名单，检索前先按名单过滤，越权内容不可见。"
  },
  {
   "source_id": "t10-en",
   "lang": "en",
   "text": "Knowledge entries carry an access list; search filters by it before returning, unauthorized content stays invisible."
  },
  {
   "source_id": "t11-zh",
   "lang": "zh",
   "text": "遗忘一条记忆会同时抹掉内容并留下墓碑记录，防止备份恢复时复活。"
  },
  {
   "source_id": "t11-en",
   "lang": "en",
   "text": "Forgetting a memory erases content and leaves a tombstone so backups cannot resurrect it."
  },
  {
   "source_id": "t12-zh",
   "lang": "zh",
   "text": "通知先走网络回调，失败时自动落回站内收件箱，消息不会丢。"
  },
  {
   "source_id": "t12-en",
   "lang": "en",
   "text": "Notifications go via webhook first, falling back to an inbox on failure so messages are not lost."
  },
  {
   "source_id": "t13-zh",
   "lang": "zh",
   "text": "外部回调必须携带签名，验签不通过的请求直接拒绝并留痕。"
  },
  {
   "source_id": "t13-en",
   "lang": "en",
   "text": "External callbacks must carry a signature; requests failing verification are rejected and logged."
  },
  {
   "source_id": "t14-zh",
   "lang": "zh",
   "text": "语音转写在本地模型上完成，断网环境依然可用，结果带引擎标识。"
  },
  {
   "source_id": "t14-en",
   "lang": "en",
   "text": "Speech transcription runs on a local model, works offline, and results carry an engine tag."
  },
  {
   "source_id": "t15-zh",
   "lang": "zh",
   "text": "主模型不可用时按链路顺序切到备用模型，切换过程会记录事件。"
  },
  {
   "source_id": "t15-en",
   "lang": "en",
   "text": "When the primary model fails the chain switches to a fallback in order, and the switch is recorded."
  },
  {
   "source_id": "t16-zh",
   "lang": "zh",
   "text": "标记为敏感的数据只允许送往本地推理，绝不外发。"
  },
  {
   "source_id": "t16-en",
   "lang": "en",
   "text": "Data marked sensitive is routed only to local inference and never leaves the machine."
  },
  {
   "source_id": "t17-zh",
   "lang": "zh",
   "text": "并发请求超过队列容量时直接拒绝并提示稍后重试，而不是无限堆积。"
  },
  {
   "source_id": "t17-en",
   "lang": "en",
   "text": "Requests beyond queue capacity are rejected with a retry hint instead of piling up unbounded."
  },
  {
   "source_id": "t18-zh",
   "lang": "zh",
   "text": "单机编排文件一键启动全部服务，数据落在命名卷里。"
  },
  {
   "source_id": "t18-en",
   "lang": "en",
   "text": "A single compose file boots all services with data kept in named volumes."
  },
  {
   "source_id": "t19-zh",
   "lang": "zh",
   "text": "轻量集群上验证过Pod就绪、存储绑定与探针健康。"
  },
  {
   "source_id": "t19-en",
   "lang": "en",
   "text": "A lightweight cluster was verified for pod readiness, volume binding and health probes."
  },
  {
   "source_id": "t20-zh",
   "lang": "zh",
   "text": "定期备份数据目录，恢复演练验证记录完整、服务可继续。"
  },
  {
   "source_id": "t20-en",
   "lang": "en",
   "text": "The data directory is backed up on schedule; restore drills verify records survive and service resumes."
  },
  {
   "source_id": "t21-zh",
   "lang": "zh",
   "text": "中文按连续三字切分建立倒排，双字词查询也能命中。"
  },
  {
   "source_id": "t21-en",
   "lang": "en",
   "text": "Chinese text is indexed by overlapping trigrams so two-character queries still match."
  },
  {
   "source_id": "t22-zh",
   "lang": "zh",
   "text": "文本转成向量后用近邻索引召回，与关键词检索融合排序。"
  },
  {
   "source_id": "t22-en",
   "lang": "en",
   "text": "Text is embedded and recalled via nearest-neighbor index, fused with keyword retrieval ranking."
  },
  {
   "source_id": "t23-zh",
   "lang": "zh",
   "text": "计算节点先配对再派发，未配对或被撤销的节点会拒绝任务。"
  },
  {
   "source_id": "t23-en",
   "lang": "en",
   "text": "Compute nodes must pair before dispatch; unpaired or revoked nodes are refused work."
  },
  {
   "source_id": "t24-zh",
   "lang": "zh",
   "text": "产物以引用形式登记，下载时校验指纹，两端一致才交付。"
  },
  {
   "source_id": "t24-en",
   "lang": "en",
   "text": "Artifacts are registered as references; downloads verify fingerprints on both ends before delivery."
  },
  {
   "source_id": "t25-zh",
   "lang": "zh",
   "text": "连接中断时任务转入不确定态等待对账，恢复后补传结果而不盲目重做。"
  },
  {
   "source_id": "t25-en",
   "lang": "en",
   "text": "On disconnect the task goes uncertain pending reconciliation; after recovery results are reconciled instead of blindly redone."
  },
  {
   "source_id": "t26-zh",
   "lang": "zh",
   "text": "执行者持有带期限的租约，到期未续约时其他实例可以接管。"
  },
  {
   "source_id": "t26-en",
   "lang": "en",
   "text": "An executor holds a leased mandate; if it expires unrenewed another instance may take over."
  },
  {
   "source_id": "t27-zh",
   "lang": "zh",
   "text": "取消请求与执行并发时，已确认的写动作不会二次执行。"
  },
  {
   "source_id": "t27-en",
   "lang": "en",
   "text": "When cancellation races execution, already-confirmed writes are never performed twice."
  },
  {
   "source_id": "t28-zh",
   "lang": "zh",
   "text": "轻量决策先用规则回答，规则没覆盖的问题选择弃权而不是瞎猜。"
  },
  {
   "source_id": "t28-en",
   "lang": "en",
   "text": "Lightweight decisions answer by rules first; uncovered questions abstain rather than guess."
  },
  {
   "source_id": "t29-zh",
   "lang": "zh",
   "text": "未完成校准前决策只记录不执行，避免未验证的策略进入关键路径。"
  },
  {
   "source_id": "t29-en",
   "lang": "en",
   "text": "Before calibration completes decisions are shadow-only, keeping unproven policies off the critical path."
  },
  {
   "source_id": "t30-zh",
   "lang": "zh",
   "text": "效率对照以同批任务的人工耗时为基线，用实测而不是估计。"
  },
  {
   "source_id": "t30-en",
   "lang": "en",
   "text": "Efficiency comparison baselines on human time for the same batch, measured not estimated."
  }
 ],
