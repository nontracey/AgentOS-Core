# Official Temporal CLI, wrapped without a custom workflow server implementation.
# Select a matching pinned BASE_IMAGE and Temporal binary for your target platform.
ARG BASE_IMAGE=redis@sha256:c9d92d840fd011c908f040592857c724ae6d877f2aba5c40ad963276507386b2
FROM ${BASE_IMAGE}
COPY temporal /usr/local/bin/temporal
ENTRYPOINT ["/usr/local/bin/temporal"]
